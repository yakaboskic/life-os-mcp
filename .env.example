# Copy to .env and chmod 600. Never commit real values.
# Provisioning scripts require these deployment-specific settings.
LIFE_OS_PROJECT=your-gcp-project
LIFE_OS_REPOSITORY=your-github-name/life-os-mcp
LIFE_OS_ALERT_EMAIL=owner@example.com

# Private Vercel production environment. One exact account is allowed.
LIFE_OS_ALLOWED_EMAIL=owner@example.com
LIFE_OS_PUBLIC_URL=https://your-life-os.vercel.app
# Optional public product homepage on your own website; policies live at /privacy and /terms beneath it.
LIFE_OS_BRANDING_URL=
# Optional app selector on shared policies, e.g. lifeos; adds ?app=lifeos to policy links.
LIFE_OS_BRANDING_APP=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
LIFE_OS_GATEWAY_URL=
LIFE_OS_GATEWAY_TOKEN=
LIFE_OS_SESSION_SECRET=

# Store the real key in Secret Manager for the VM.
TYPESAFE_API_KEY=

# Optional review/brief worker. Claude Code uses its own native login on the VM.
# No Claude OAuth token belongs in this file, Vercel, or the application database.
LIFE_OS_AGENT_PROVIDER=claude-code
LIFE_OS_AGENT_SOCKET=/run/life-os-agent/runner.sock
LIFE_OS_CLAUDE_MODEL=claude-sonnet-5-5
LIFE_OS_AUTOMATION_ENABLED=false
LIFE_OS_BRIEF_ACCOUNT=owner@example.com
LIFE_OS_BRIEF_RECIPIENT=owner@example.com
# For the alternative anthropic-api provider only (separate API billing):
ANTHROPIC_API_KEY=
