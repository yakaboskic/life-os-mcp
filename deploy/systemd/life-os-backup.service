[Unit]
Description=Consistent encrypted-in-transit LifeOS off-host backup
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/life-os
ConditionPathExists=/opt/life-os/current/dist/index.js

[Service]
Type=oneshot
User=lifeos
Group=lifeos
EnvironmentFile=/etc/life-os/runtime.env
EnvironmentFile=-/etc/life-os/release.env
ExecStart=/usr/local/lib/life-os/backup-upload.sh
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/life-os
