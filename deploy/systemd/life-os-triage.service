[Unit]
Description=LifeOS daily Gmail triage
After=life-os.service network-online.target
Requires=life-os.service
RequiresMountsFor=/var/lib/life-os

[Service]
Type=oneshot
User=lifeos
Group=lifeos
EnvironmentFile=/etc/life-os/runtime.env
ExecStart=/opt/life-os/current/bin/life-os jobs run gmail-triage --mode ${LIFE_OS_TRIAGE_MODE} --wait --scheduled
TimeoutStartSec=100min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/life-os
