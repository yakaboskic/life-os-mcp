[Unit]
Description=LifeOS authoritative backend and dashboard
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/life-os
ConditionPathExists=/opt/life-os/current/dist/index.js

[Service]
Type=simple
User=lifeos
Group=lifeos
WorkingDirectory=/opt/life-os/current
EnvironmentFile=/etc/life-os/runtime.env
EnvironmentFile=-/etc/life-os/release.env
ExecStart=/opt/life-os/current/bin/life-os daemon
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/life-os
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
