{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": { "api/index.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
